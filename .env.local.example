# =============================================================================
# Environment Variables Checklist
# =============================================================================
# Copy this file to .env.local and fill in the values
# =============================================================================

# -----------------------------------------------------------------------------
# Next.js API Configuration
# -----------------------------------------------------------------------------

# API endpoint rewrite - used by browser/client for API calls
# This should match your Vercel/Next.js serverless functions
NEXT_PUBLIC_API_URL=/api/backend

# -----------------------------------------------------------------------------
# Backend Internal URL (Server-to-Server)
# -----------------------------------------------------------------------------

# FastAPI CRM backend URL (server-side only - NOT for browser)
# Used by Next.js server routes to communicate with FastAPI CRM
# Example: http://localhost:8000/api/v1 (development)
# Example: https://crm.yourdomain.com/api/v1 (production)
BACKEND_INTERNAL_URL=http://localhost:8000/api/v1

# -----------------------------------------------------------------------------
# Supabase (Required for client portal & real-time features)
# -----------------------------------------------------------------------------

# Supabase project URL (get from Supabase Dashboard → Project Settings)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Supabase anonymous/public key (for client-side)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Optional: Supabase service role key (for server-side admin operations)
# Not exposed to browser - used in .env.local on server
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# -----------------------------------------------------------------------------
# CRM Webhook Security
# -----------------------------------------------------------------------------

# HMAC-SHA256 secret for validating incoming CRM webhooks
# This secret must match the one configured in your FastAPI CRM
# Generate a secure random value: openssl rand -hex 32
# WARNING: Never commit this to version control
CRM_WEBHOOK_SECRET=your-webhook-secret-here

# -----------------------------------------------------------------------------
# Webhook Rate Limiting (Optional)
# -----------------------------------------------------------------------------

# Enable/disable webhook rate limiting (default: enabled)
# Set to "false" to disable rate limiting
# Rate limit: 100 requests per minute per IP
ENABLE_WEBHOOK_RATE_LIMIT=true

# -----------------------------------------------------------------------------
# Internal API Key (Optional)
# -----------------------------------------------------------------------------

# Internal API key for server-to-server authentication
# Used for internal service communication
INTERNAL_API_KEY=your-internal-api-key-here

# -----------------------------------------------------------------------------
# Application Configuration
# -----------------------------------------------------------------------------

# Node.js environment (automatically set by Next.js)
NODE_ENV=development

# -----------------------------------------------------------------------------
# Development/Testing Only (Do NOT use in production)
# -----------------------------------------------------------------------------

# If CRM_WEBHOOK_SECRET is not set in development, HMAC validation is skipped
# WARNING: Production MUST have CRM_WEBHOOK_SECRET configured
# Setting this to "true" in production is a security risk
SKIP_WEBHOOK_VALIDATION_FOR_TESTING=false

# =============================================================================
# Required Environment Variables Summary
# =============================================================================

# MINIMUM REQUIRED (for basic operation):
#   ✓ BACKEND_INTERNAL_URL
#   ✓ NEXT_PUBLIC_SUPABASE_URL
#   ✓ NEXT_PUBLIC_SUPABASE_ANON_KEY
#   ✓ CRM_WEBHOOK_SECRET (for webhook security)

# OPTIONAL (improved security/functionality):
#   ✓ ENABLE_WEBHOOK_RATE_LIMIT (default: true)
#   ✓ INTERNAL_API_KEY (for internal service auth)

# =============================================================================
# Migration Required Tables
# =============================================================================

# Run the following migration to create required tables:
#   scripts/migrations/001_webhook_processing_log.sql
#
# Tables created by migration:
#   - webhook_processing_log (for request deduplication)
#
# Existing tables (pre-existing in Supabase):
#   - profiles
#   - travel_requests
#   - document_requirements
#   - customer_documents
#   - customer_communications
#   - system_logs (if using crm-adapter logging)
# =============================================================================
